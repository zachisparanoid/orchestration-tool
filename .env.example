# =============================================================================
# Runtime selection
# =============================================================================
# The orchestrator auto-selects a backend (highest priority first):
#   1. "cli"  — calls the `claude` CLI, using the host's Claude Code login
#               (counts against your Pro/Max subscription, not API billing).
#   2. "api"  — uses the Anthropic SDK with ANTHROPIC_API_KEY (per-token).
#   3. "mock" — deterministic synthetic output, no credentials needed.
#
# Force a specific mode:
# RUNTIME=cli

# =============================================================================
# CLI mode settings
# =============================================================================
# Path to the `claude` binary. Auto-detected from PATH if unset.
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# Path to the host user's .claude directory (where credentials live).
# Defaults to $HOME/.claude. Override if the service runs as a different user.
# CLAUDE_HOME_DIR=/home/orchestrator/.claude

# Isolated config dir the orchestrator uses for its calls. Avoids loading
# the host user's hooks, skills, plugins, or CLAUDE.md. Default:
# CLAUDE_ISOLATED_DIR=./data/claude-isolated

# =============================================================================
# API mode settings (only used when RUNTIME=api or CLI is unavailable)
# =============================================================================
# ANTHROPIC_API_KEY=

# =============================================================================
# Engine knobs
# =============================================================================
# Default model used when an agent doesn't specify its own.
DEFAULT_MODEL=claude-sonnet-4-6

# Max parallel agent executions across the engine. Tune for your machine /
# subscription rate limits.
MAX_CONCURRENCY=12
